---
import { Image } from 'astro:assets';
import type { PhotoSlot } from '../config/studio';
import { resolvePhoto } from '../lib/media';

/**
 * Photo déclarée dans studio.ts. Tant que `photo.file` est null, affiche un
 * aplat avec le sujet attendu. Les proportions viennent de la classe passée
 * par le composant parent : la place est réservée dans les deux cas (CLS 0).
 */
interface Props {
  photo: PhotoSlot;
  widths: number[];
  sizes: string;
  /** Photo du hero : chargement immédiat et prioritaire. */
  priority?: boolean;
  class?: string;
}

const { photo, widths, sizes, priority = false, class: className } = Astro.props;

const src = resolvePhoto(photo);
---

<div class:list={['photo', !src && 'photo--empty', className]}>
  {
    src ? (
      <Image
        src={src}
        alt={photo.alt}
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <p class="photo__subject">[ {photo.subject} ]</p>
    )
  }
</div>
