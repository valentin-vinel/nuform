---
import { getImage } from 'astro:assets';
import { studio } from '../config/studio';
import { resolvePhoto } from '../lib/media';
import { titleHtml } from '../lib/text';
import Photo from './Photo.astro';

const { eyebrow, title, text, swipeHint, photos } = studio.sections.studio;

// Version grand format pour la visionneuse, téléchargée seulement à l'ouverture.
// Jamais agrandie au-delà du fichier d'origine.
const slides = await Promise.all(
  photos.map(async (slot) => {
    const src = resolvePhoto(slot);
    if (!src) return null;
    const large = await getImage({ src, width: Math.min(1600, src.width), format: 'webp' });
    return { url: large.src, alt: slot.alt };
  }),
);
const zoomable = slides.filter((slide) => slide !== null);
---

<section class="section section--soft" aria-labelledby="studio-titre">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="title" id="studio-titre" set:html={titleHtml(title)} />

    <ul class="gallery" aria-label="Photos du studio">
      {photos.map((photo, i) => {
        const slide = slides[i];
        const image = (
          <Photo
            photo={photo}
            class="gallery__photo"
            widths={[320, 480, 720]}
            sizes="(min-width: 860px) 370px, 72vw"
          />
        );
        return (
          <li>
            {slide ? (
              <button
                type="button"
                class="gallery__open"
                data-index={zoomable.indexOf(slide)}
                aria-label={`Agrandir : ${slide.alt}`}
              >
                {image}
              </button>
            ) : (
              image
            )}
          </li>
        );
      })}
    </ul>

    <p class="gallery__hint only-mobile" aria-hidden="true">{swipeHint}</p>
    {text && <p class="lead">{text}</p>}
  </div>

  {zoomable.length > 0 && (
    <dialog class="lightbox" id="lightbox" aria-label="Photos du studio en grand">
      <figure class="lightbox__figure">
        {/* Source fixée au clic, depuis les URL générées par getImage ci-dessus. */}
        <img class="lightbox__img" alt="" decoding="async" />
      </figure>
      <p class="lightbox__count" aria-live="polite"></p>
      <button type="button" class="lightbox__btn lightbox__close" data-action="close" aria-label="Fermer">×</button>
      {zoomable.length > 1 && (
        <>
          <button type="button" class="lightbox__btn lightbox__prev" data-action="prev" aria-label="Photo précédente">‹</button>
          <button type="button" class="lightbox__btn lightbox__next" data-action="next" aria-label="Photo suivante">›</button>
        </>
      )}
      <script is:inline type="application/json" id="lightbox-data" set:html={JSON.stringify(zoomable)} />
    </dialog>
  )}
</section>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const data = document.getElementById('lightbox-data');

  if (dialog && data) {
    const slides: { url: string; alt: string }[] = JSON.parse(data.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      img.src = slides[current].url;
      img.alt = slides[current].alt;
      count.textContent = `${current + 1} / ${slides.length}`;
    };

    document.querySelectorAll<HTMLButtonElement>('.gallery__open').forEach((button) => {
      button.addEventListener('click', () => {
        opener = button;
        show(Number(button.dataset.index));
        dialog.showModal();
      });
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'close' || target === dialog) dialog.close();
      else if (action === 'prev') show(current - 1);
      else if (action === 'next') show(current + 1);
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Glissé horizontal sur mobile.
    let startX = 0;
    dialog.addEventListener('touchstart', (event) => { startX = event.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    // À la fermeture : focus rendu à la photo cliquée, image libérée.
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
  }
</script>
