---
import { studio } from '../config/studio';
import { fill, titleHtml } from '../lib/text';
import LeadForm from './LeadForm.astro';

const { eyebrow, title, text, facts, steps } = studio.sections.offer;
---

<section class="section discovery" aria-labelledby="offre-titre">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="title" id="offre-titre" set:html={titleHtml(title)} />
    {text && <p class="lead">{text}</p>}

    <div class="discovery__grid">
      <dl class="card discovery__facts">
        {facts.map((fact) => (
          <div class="fact">
            <dt class="fact__label">{fact.label}</dt>
            <dd class="fact__value">{fill(fact.value)}</dd>
          </div>
        ))}
      </dl>

      <LeadForm class="discovery__form" />

      {steps.length > 0 && (
        <ol class="discovery__steps">
          {steps.map((step) => <li>{step}</li>)}
        </ol>
      )}
    </div>
  </div>
</section>
